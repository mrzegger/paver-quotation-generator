# =============================================================================
# Kuma Concrete Paver Quotation Generator - Environment Variables
# =============================================================================
# Copy this file to .env.local for local development, or add these keys to
# your Vercel Project Settings (Project > Settings > Environment Variables).
#
# Get these values from your Supabase Dashboard: Project Settings > API
# =============================================================================

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-api-key-here

# Optional comma-separated list of authorized Gmail/email addresses
# (used alongside the public.allowed_emails table in Supabase RLS):
# VITE_ALLOWED_EMAILS=you@gmail.com,teammate@gmail.com
